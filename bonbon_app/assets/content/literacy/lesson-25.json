    {
      "id": "lesson-25-block-08",
      "type": "reading_passage",
      "source": {
        "pdfPages": [56],
        "printedPages": [55]
      },
      "title": "Les vacances",
      "preserveSourceOrder": true,
      "segments": [
        {
          "id": "lesson-25-block-08-segment-1",
          "type": "narration",
          "text": "Je passe souvent les vacances avec ma tante Baké à Kandi. Elle habite une grande maison située à l’entrée de la ville en venant de Cotonou.",
          "audio": {
            "key": "fr:lesson-25:passage-8-segment-1",
            "fallbackText": "Je passe souvent les vacances avec ma tante Baké à Kandi. Elle habite une grande maison située à l’entrée de la ville en venant de Cotonou."
          }
        },
        {
          "id": "lesson-25-block-08-segment-2",
          "type": "narration",
          "text": "Ma tante a un restaurant où elle vend des différents mets. De temps en temps, je l’aide à servir les clients, je lave aussi les assiettes sales utilisées par les clients. J’aime beaucoup ce travail et je m’empresse pour satisfaire les demandes des clients.",
          "audio": {
            "key": "fr:lesson-25:passage-8-segment-2",
            "fallbackText": "Ma tante a un restaurant où elle vend des différents mets. De temps en temps, je l’aide à servir les clients, je lave aussi les assiettes sales utilisées par les clients. J’aime beaucoup ce travail et je m’empresse pour satisfaire les demandes des clients."
          }
        },
        {
          "id": "lesson-25-block-08-segment-3",
          "type": "narration",
          "text": "C’est toujours une joie pour moi quand je pars en vacances.",
          "audio": {
            "key": "fr:lesson-25:passage-8-segment-3",
            "fallbackText": "C’est toujours une joie pour moi quand je pars en vacances."
          }
        }
      ]
    }
