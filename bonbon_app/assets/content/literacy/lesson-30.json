      },
      "title": "Des amis",
      "preserveSourceOrder": true,
      "segments": [
        {
          "id": "lesson-30-block-08-segment-1",
          "type": "narration",
          "text": "Antoine voit son ami Benoît.",
          "audio": {
            "key": "fr:lesson-30:passage-8-segment-1",
            "fallbackText": "Antoine voit son ami Benoît."
          }
        },
        {
          "id": "lesson-30-block-08-segment-2",
          "type": "dialogue",
          "turns": [
            {
              "id": "lesson-30-block-08-segment-2-turn-1",
              "text": "Bonsoir Benoît, où vas tu de ce pas ?",
              "audio": {
                "key": "fr:lesson-30:passage-8-turn-2-1",
                "fallbackText": "Bonsoir Benoît, où vas tu de ce pas ?"
              }
            },
            {
              "id": "lesson-30-block-08-segment-2-turn-2",
              "text": "Je vais acheter des noix de coco dans la maison sans toit que tu vois là-bas.",
              "audio": {
                "key": "fr:lesson-30:passage-8-turn-2-2",
                "fallbackText": "Je vais acheter des noix de coco dans la maison sans toit que tu vois là-bas."
              }
            },
            {
              "id": "lesson-30-block-08-segment-2-turn-3",
              "text": "Laisse-moi donc t’accompagner.",
              "audio": {
                "key": "fr:lesson-30:passage-8-turn-2-3",
                "fallbackText": "Laisse-moi donc t’accompagner."
              }
            }
          ]
        }
      ]
    }
