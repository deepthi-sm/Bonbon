      "source": {
        "pdfPages": [65],
        "printedPages": [64]
      },
      "heading": "Des conseils",
      "preserveSourceOrder": true,
      "paragraphs": [
        {
          "id": "lesson-34-advice-01",
          "text": "Mon enfant :"
        },
        {
          "id": "lesson-34-advice-02",
          "text": "aime le travail;"
        },
        {
          "id": "lesson-34-advice-03",
          "text": "travaille bien en classe;"
        },
        {
          "id": "lesson-34-advice-04",
          "text": "aide tes parents à la maison;"
        },
        {
          "id": "lesson-34-advice-05",
          "text": "écoute bien ton maître et ne baille pas en classe;"
        },
        {
          "id": "lesson-34-advice-06",
          "text": "ne joue pas près des rails ou d’un tas de ferraille;"
        },
        {
          "id": "lesson-34-advice-07",
          "text": "travaille toujours de toutes tes forces;"
        },
        {
          "id": "lesson-34-advice-08",
          "text": "n’oublie pas que : «La vie est une bataille.»"
        }
      ]
    }
  ],
