      "title": "Une histoire",
      "preserveSourceOrder": true,
      "segments": [
        {
          "id": "lesson-42-narration-01",
          "type": "narration",
          "text": "Le Samedi soir, Victoire va voir sa mère.",
          "audio": {
            "key": "fr:lesson-42:narration-01",
            "fallbackText": "Le Samedi soir, Victoire va voir sa mère."
          }
        },
        {
          "id": "lesson-42-dialogue",
          "type": "dialogue",
          "turns": [
            {
              "id": "lesson-42-dialogue-01",
              "text": "Bonsoir maman, je veux m’asseoir sur vos genoux pour écouter une belle histoire. Êtes-vous d’accord maman ?",
              "audio": {
                "key": "fr:lesson-42:dialogue-01",
                "fallbackText": "Bonsoir maman, je veux m’asseoir sur vos genoux pour écouter une belle histoire. Êtes-vous d’accord maman ?"
              }
            },
            {
              "id": "lesson-42-dialogue-02",
              "text": "Oui mais donne-moi à boire d’abord. Ensuite, allume-moi la lampe à pétrole car il fait déjà noir.",
              "audio": {
                "key": "fr:lesson-42:dialogue-02",
                "fallbackText": "Oui mais donne-moi à boire d’abord. Ensuite, allume-moi la lampe à pétrole car il fait déjà noir."
              }
            }
          ]
        },
        {
          "id": "lesson-42-narration-02",
          "type": "narration",
          "text": "Victoire fait tout ce que sa mère lui demande parce qu’elle veut écouter sa belle histoire.",
          "audio": {
            "key": "fr:lesson-42:narration-02",
            "fallbackText": "Victoire fait tout ce que sa mère lui demande parce qu’elle veut écouter sa belle histoire."
          }
        }
