{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'Flutter is installed by the build script'",
  "buildCommand": "bash bonbon_app/tool/vercel_build.sh",
  "outputDirectory": "bonbon_app/build/web",
  "git": {
    "deploymentEnabled": {
      "dev/*": false,
      "develop": false
    }
  },
  "headers": [
    {
      "source": "/(index.html|main.dart.js|flutter_bootstrap.js|flutter_service_worker.js|version.json)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
